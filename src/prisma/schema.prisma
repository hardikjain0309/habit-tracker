datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output = "./generated"
}

model User {
  id String @db.Uuid() @default(uuid())
  createdAt DateTime @default(now())
  email String @unique
  name String
  passwordHash String
}

model UserSessions {
  sessionId String
  refreshTokenHash String @unique
  expiresAt DateTime
}
